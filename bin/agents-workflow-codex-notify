#!/bin/bash
# Codex `notify' wrapper for agents-workflow.
#
# Codex invokes this on `agent-turn-complete', appending the event JSON
# (which includes `last-assistant-message') as the final argument, and the
# process inherits Codex's environment + working directory.  We push the
# finished reply to Emacs, mirroring Claude Code's Stop hook: the JSON is
# passed as a trailing emacsclient arg and read from `server-eval-args-left'
# by `agents-workflow-handle-codex-reply'.  Explicit per-session arguments
# carry workflow, agent and launch identity.  A shared app server inherits
# only its first client's environment, so never use environment identity.
wf=""
agent=""
token=""
if [[ "${1:-}" == "--route" ]]; then
    [[ "$#" -eq 5 ]] || exit 0
    wf="$2"
    agent="$3"
    token="$4"
    json="$5"
else
    [[ "$#" -eq 1 ]] || exit 0
    # Existing terminals can still notify using their unique thread ID.
    json="$1"
fi
[ -z "$json" ] && exit 0
esc() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }
dir="$(esc "$PWD")"
agent="$(esc "$agent")"
wf="$(esc "$wf")"
token="$(esc "$token")"
emacsclient --eval "(agents-workflow-handle-codex-reply \"$dir\" \"$agent\" \"$wf\" \"$token\")" "$json" >/dev/null 2>&1 || true
exit 0
